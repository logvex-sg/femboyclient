# Gradle
# Anchored to the repository root: a bare `build/` also matches the source package
# src/main/java/com/logvex/crystal/world/build, which silently kept it out of git.
/.gradle/
/build/
/out/

# Loom dev-run artifacts
/run/
/run-*/

# IDE
.idea/
*.iml
.vscode/
*.ipr
*.iws

# OS
.DS_Store

# Python tooling bytecode
__pycache__/
*.pyc

# Agent-local memory (never committed)
.openhands/

# Distribution output
dist/

# Runtime logs
logs/
